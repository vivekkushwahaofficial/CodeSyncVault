{
  "name": "codevault",
  "version": "1.4.1",
  "private": true,
  "description": "CodeVault - Automatic coding solution manager for LeetCode, GeeksforGeeks, and more.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "biome format . --write",
    "check": "biome check .",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format && pnpm check && pnpm typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  }
}